# =====================================================================
# NOVA Platform — Backend Environment Variables
# =====================================================================

# 1. Server Configuration
PORT=3001
NODE_ENV=development

# 2. Admin Auth (for admin panel login)
JWT_SECRET=your_super_secret_jwt_string_here
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=generate_with_bcrypt_and_paste_here

# 3. Database (MongoDB Atlas)
# Get this from: https://cloud.mongodb.com → Database → Connect → Drivers
MONGODB_URI=mongodb+srv://user:<password>@<cluster>.mongodb.net/novadb?retryWrites=true&w=majority

# 4. File Uploads (Cloudinary)
# Get these from: https://cloudinary.com/console → Dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# 5. Email Service (Resend)
# Get this from: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=noreply@yourdomain.com

# 6. Clerk Authentication (for Team Finder user auth)
# Get this from: https://dashboard.clerk.com → Your App → API Keys
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
